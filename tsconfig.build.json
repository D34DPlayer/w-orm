{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "rootDir": "./src",
    "module": "CommonJS",
    "types": [
      "reflect-metadata",
      "node"
    ],
    "strict": true,
    "outDir": "./dist/lib",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*"
  ]
}
