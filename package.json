{
  "name": "@d34d/w-orm",
  "type": "module",
  "version": "0.6.0",
  "packageManager": "pnpm@12.17.0",
  "description": "IndexedDB ORM",
  "author": {
    "name": "D34DPlayer",
    "email": "carlos@d34d.one",
    "url": "https://github.com/D34DPlayer"
  },
  "license": "MIT",
  "homepage": "https://github.com/D34DPlayer/w-orm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D34DPlayer/w-orm.git"
  },
  "bugs": {
    "url": "https://github.com/D34DPlayer/w-orm/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "rimraf dist",
    "build:lib": "tsc -p tsconfig.build.json --module commonjs",
    "build:dist": "vite build",
    "build:docs": "typedoc ./src/index.ts ./src/types.ts ./src/errors.ts",
    "build": "pnpm build:dist && pnpm build:lib",
    "serve:docs": "serve docs",
    "serve:coverage": "serve coverage",
    "start": "vite",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm lint",
    "preversion": "pnpm lint",
    "version": "pnpm lint:fix && git add -A src",
    "postversion": "git push && git push --tags",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch --ui"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@microsoft/api-extractor": "^7.60.1",
    "@shipgirl/typedoc-plugin-versions": "^0.3.3",
    "@types/node": "^26.6.6",
    "@typescript/lib-dom": "npm:@types/web@^0.0.360",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.4",
    "serve": "^14.2.6",
    "simple-git-hooks": "^2.14",
    "ts-node": "^10.9",
    "tslib": "^2.9",
    "typedoc": "^0.28.20",
    "typedoc-rhineai-theme": "^1.2.0",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint . --fix"
  }
}
